---
// Top bar dropdown menus (desktop). Opens on hover or keyboard focus — no JavaScript needed.
import { getDocIconsByHref } from '~/lib/docIcons';
import { useT } from '~/lib/i18n';
import { isExternalHref, normalizeHref } from '~/lib/urls';
import { getNavMenus, type NavLink } from '~/nav';
import PageIcon from './PageIcon.astro';

const pageIcons = await getDocIconsByHref();
const current = normalizeHref(Astro.url.pathname);
const locale = Astro.locals.starlightRoute.locale;
const t = useT(locale);
const navMenus = getNavMenus(locale);

const iconOf = (link: NavLink) => link.icon ?? pageIcons.get(normalizeHref(link.href));
const menuHasCurrent = (items: NavLink[]) => items.some((i) => normalizeHref(i.href) === current);
---

<nav class="header-nav" aria-label={t('nav.main')}>
	<ul class="menus">
		{
			navMenus.map((menu) => (
				<li class="menu">
					<button type="button" class:list={['trigger', { active: menuHasCurrent(menu.items) }]} aria-haspopup="true">
						{menu.label}
						<svg class="chevron" viewBox="0 0 24 24" aria-hidden="true">
							<path d="m6 9 6 6 6-6" />
						</svg>
					</button>
					<div class="panel">
						<ul class:list={{ wide: menu.items.length > 9 }}>
							{menu.items.map((item) => (
								<>
									{item.divider && <li class="sep" role="separator" />}
									<li>
										<a
											href={item.href}
											aria-current={normalizeHref(item.href) === current ? 'page' : undefined}
											{...(isExternalHref(item.href) ? { target: '_blank', rel: 'noopener' } : {})}
										>
											<PageIcon name={iconOf(item)} />
											<span class="label">{item.label}</span>
											{isExternalHref(item.href) && (
												<svg class="external" viewBox="0 0 24 24" aria-label={t('external.newTab')}>
													<path d="M7 17 17 7M9 7h8v8" />
												</svg>
											)}
										</a>
									</li>
								</>
							))}
						</ul>
					</div>
				</li>
			))
		}
	</ul>
</nav>

<style>
	/* Only in the desktop header; the sidebar covers smaller screens and the mobile menu. */
	.header-nav {
		display: none;
	}
	@media (min-width: 64rem) {
		:global(.header) .header-nav {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
	}

	.menus {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.menu {
		position: relative;
	}

	.trigger {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.375rem 0.5rem;
		border: 0;
		border-radius: 0.375rem;
		background: none;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		cursor: pointer;
		transition:
			color 0.15s,
			background-color 0.15s;
	}
	.trigger.active {
		color: var(--sl-color-text-accent);
	}
	.menu:hover .trigger,
	.menu:focus-within .trigger {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.chevron {
		width: 0.875rem;
		height: 0.875rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.15s;
	}
	.menu:hover .chevron,
	.menu:focus-within .chevron {
		transform: rotate(180deg);
	}

	/* The panel starts right below the trigger (padding bridges the gap so hover isn't lost). */
	.panel {
		position: absolute;
		top: 100%;
		left: 50%;
		z-index: 20;
		padding-top: 0.5rem;
		visibility: hidden;
		opacity: 0;
		transform: translate(-50%, -0.25rem);
		transition:
			opacity 0.15s,
			transform 0.15s,
			visibility 0.15s;
	}
	.menu:hover .panel,
	.menu:focus-within .panel {
		visibility: visible;
		opacity: 1;
		transform: translate(-50%, 0);
	}
	.panel ul {
		min-width: 14rem;
		margin: 0;
		padding: 0.375rem;
		list-style: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
	}
	/* Long menus split into two columns instead of running off the screen. */
	.panel ul.wide {
		display: grid;
		grid-template-columns: repeat(2, minmax(13rem, auto));
		width: max-content;
		column-gap: 0.25rem;
	}
	/* Separates external resources from the site's own pages, across both columns. */
	.panel .sep {
		grid-column: 1 / -1;
		height: 1px;
		margin: 0.375rem 0.25rem;
		background: var(--sl-color-gray-5);
	}
	.panel a {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.4rem 0.625rem;
		border-radius: 0.375rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-decoration: none;
		white-space: nowrap;
	}
	.panel a:hover,
	.panel a:focus-visible {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.panel a[aria-current='page'] {
		color: var(--sl-color-text-accent);
	}
	.panel a :global(.page-icon) {
		flex: none;
		font-size: 1rem;
		opacity: 0.8;
	}
	.label {
		flex: 1;
	}
	.external {
		flex: none;
		width: 0.875rem;
		height: 0.875rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0.6;
	}

</style>
