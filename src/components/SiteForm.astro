---
// The contact and feedback forms, posted to Formspree with fetch so readers stay on the page.
import { useT } from '~/lib/i18n';

interface Props {
	kind: 'contact' | 'feedback';
}

const { kind } = Astro.props;
const t = useT(Astro.locals.starlightRoute.locale);
const endpoint = { contact: 'https://formspree.io/f/mldrnnjr', feedback: 'https://formspree.io/f/mrpbjqqv' }[kind];
const stars = [5, 4, 3, 2, 1];
---

<form class="site-form not-content" action={endpoint} method="POST" data-success={t('form.success')} data-error={t('form.error')}>
	{
		kind === 'contact' ? (
			<>
				<label>
					<span>{t('contact.name')}</span>
					<input type="text" name="name" required autocomplete="name" maxlength="100" />
				</label>
				<label>
					<span>{t('contact.email')}</span>
					<input type="email" name="email" required autocomplete="email" maxlength="200" />
				</label>
				<label>
					<span>{t('contact.content')}</span>
					<textarea name="message" required rows="7" maxlength="5000" />
				</label>
			</>
		) : (
			<>
				<fieldset>
					<legend>{t('feedback.question')}</legend>
					{/* Listed 5 to 1 and reversed by CSS, so hovering a star also fills the ones before it. */}
					<div class="stars">
						{stars.map((n) => (
							<Fragment set:key={n}>
								<input type="radio" name="rating" id={`star-${n}`} value={n} required />
								<label for={`star-${n}`} title={`${n} / 5`}>
									<span class="sr-only">{n} / 5</span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="m12 17.75-6.172 3.245 1.179-6.873-4.993-4.867 6.9-1.002L12 2l3.086 6.253 6.9 1.002-4.993 4.867 1.179 6.873z" />
									</svg>
								</label>
							</Fragment>
						))}
					</div>
					<div class="scale" aria-hidden="true">
						<span>{t('feedback.low')}</span>
						<span>{t('feedback.high')}</span>
					</div>
				</fieldset>
				<label>
					<span>{t('feedback.message')}</span>
					<textarea name="message" required rows="5" maxlength="5000" />
				</label>
			</>
		)
	}
	<!-- Honeypot: hidden from people, filled in by bots. Formspree drops submissions that set it. -->
	<input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
	<button type="submit">{t('form.send')}</button>
	<p class="status" role="status" hidden></p>
</form>

<style>
	.site-form {
		display: grid;
		gap: 1.25rem;
		max-width: 36rem;
		margin-top: 1.5rem;
	}
	label,
	legend {
		display: grid;
		gap: 0.375rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}
	legend {
		margin-bottom: 0.5rem;
		padding: 0;
	}
	input:not(.hp):not([type='radio']),
	textarea {
		width: 100%;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-white);
		font: inherit;
		font-weight: 400;
	}
	textarea {
		resize: vertical;
	}
	input:not(.hp):not([type='radio']):focus,
	textarea:focus {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 1px;
		border-color: var(--sl-color-text-accent);
	}

	/* Star rating. Radios are visually hidden but stay focusable and keyboard operable. */
	.stars {
		display: flex;
		flex-direction: row-reverse;
		justify-content: flex-end;
		gap: 0.25rem;
	}
	.stars input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}
	.stars label {
		display: block;
		cursor: pointer;
		color: var(--sl-color-gray-4);
		transition: color 0.1s;
	}
	.stars svg {
		display: block;
		width: 2.25rem;
		height: 2.25rem;
		fill: currentColor;
	}
	.stars input:checked ~ label,
	.stars label:hover,
	.stars label:hover ~ label {
		color: var(--sl-color-accent);
	}
	.stars input:focus-visible + label {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}
	.scale {
		display: flex;
		justify-content: space-between;
		max-width: 14rem;
		margin-top: 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	button {
		justify-self: start;
		padding: 0.5rem 1.25rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.375rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button:hover:not(:disabled) {
		background: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent-high);
	}
	button:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.status {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.status.error {
		color: var(--sl-color-red);
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('form.site-form');
	if (form) {
		const status = form.querySelector<HTMLElement>('.status')!;
		const button = form.querySelector<HTMLButtonElement>('button')!;
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			button.disabled = true;
			status.hidden = true;
			status.classList.remove('error');
			try {
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				if (!res.ok) throw new Error(String(res.status));
				form.reset();
				status.textContent = form.dataset.success ?? '';
			} catch {
				status.textContent = form.dataset.error ?? '';
				status.classList.add('error');
			} finally {
				status.hidden = false;
				button.disabled = false;
			}
		});
	}
</script>
