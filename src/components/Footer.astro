---
// Starlight's footer plus one shared "need help?" bar, so pages don't each repeat a Discord card
// and a feedback nudge. Hidden on the splash homepage and on section overviews, where the
// homepage gets the site disclaimer line instead.
import Default from '@astrojs/starlight/components/Footer.astro';
import { iconSvg } from '~/lib/icons';
import { localize, useT } from '~/lib/i18n';

const { entry, locale } = Astro.locals.starlightRoute;
const t = useT(locale);
const isSplash = entry.data.template === 'splash';
const showHelp = !isSplash && !Astro.locals.sectionEntries;
const troubleshootHref = localize('/help-centre/troubleshoot/', locale);
const onTroubleshoot = Astro.url.pathname.replace(/\/?$/, '/') === troubleshootHref;
---

{
	showHelp && (
		<aside class="help not-content" aria-label={t('footer.label')}>
			<p>{t('footer.prompt')}</p>
			<div class="help-actions">
				{!onTroubleshoot && (
					<a href={troubleshootHref}>
						<Fragment set:html={iconSvg('settings')} />
						{t('footer.troubleshoot')}
					</a>
				)}
				<a href="https://discord.gg/7SBMKRy6q9" target="_blank" rel="noopener">
					<Fragment set:html={iconSvg('brand-discord')} />
					{t('footer.discord')}
				</a>
				<a href={localize('/feedback/', locale)}>
					<Fragment set:html={iconSvg('message-circle')} />
					{t('footer.feedback')}
				</a>
				<a href="https://github.com/getbf2142/getbf2142-wiki" target="_blank" rel="noopener">
					<Fragment set:html={iconSvg('brand-github')} />
					{t('footer.star')}
				</a>
			</div>
		</aside>
	)
}

<Default {...Astro.props}><slot /></Default>

{
	isSplash && (
		<p class="disclaimer">
			{t('footer.disclaimer')} <a href={localize('/disclaimer/', locale)}>{t('footer.disclaimerLink')}</a>
		</p>
	)
}

<style>
	.help {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		margin-top: 3rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--hairline);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--sl-color-accent) 4%, transparent);
		font-size: var(--sl-text-sm);
	}
	.help p {
		margin: 0;
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.help-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}
	.help-actions a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--hairline);
		border-radius: 0.375rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			border-color 0.15s,
			color 0.15s,
			background-color 0.15s;
	}
	.help-actions a:hover {
		border-color: var(--sl-color-text-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
		color: var(--sl-color-text-accent);
	}
	.help-actions :global(svg) {
		display: block;
		flex: none;
		font-size: 1rem;
	}
	.disclaimer {
		margin: 1.5rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.disclaimer a {
		color: inherit;
		text-underline-offset: 0.2em;
	}
	.disclaimer a:hover {
		color: var(--sl-color-text-accent);
	}
</style>
