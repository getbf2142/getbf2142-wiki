---
import PageIcon from './PageIcon.astro';

const { title, icon } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">
	<PageIcon name={icon} />
	<span>{title}</span>
</h1>

<style>
	h1 {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	h1 :global(.page-icon) {
		flex: none;
		font-size: 0.9em;
		color: var(--sl-color-gray-3);
	}
</style>
